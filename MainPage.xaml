<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CalculateurAge.MainPage"
             Title="Calculateur d'age">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">
            <Label Text="Entrez vos informations" 
                   FontSize="22" 
                   FontAttributes="Bold"
                   HorizontalOptions="Center"/>
            <Label Text="Nom" FontSize="16"/>
            <Entry Text="{Binding Nom, Mode=TwoWay}"
                   Placeholder="Votre nom"/>
            <Label Text="Date de naissance" FontSize="16"/>
            <DatePicker Date="{Binding DateNaissance}"/>
            <Button Text="Calculer"
                    Command="{Binding CalculerCommand}"
                    BackgroundColor="#2196F3"
                    TextColor="White"
                    Margin="0,20,0,0"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
